# ---------------------------------------------------------------------------
# Скопируйте этот файл в файл .env (команда: cp .env.example .env)
# и впишите свои значения. Файл .env НИКОГДА не попадает в код и в интернет.
# ---------------------------------------------------------------------------

# Ключ ProxyAPI. Получить: https://console.proxyapi.ru -> раздел "Ключи API".
# Выглядит так: sk-xxxxxxxxxxxxxxxx
PROXY_API_KEY=

# Адрес API (менять обычно не нужно).
PROXY_API_BASE_URL=https://api.proxyapi.ru/v1

# Модель. Любая из каталога https://proxyapi.ru/models
# Другие варианты: openai/gpt-6-1-sol, deepseek/deepseek-v4.1-flash
OPENAI_MODEL=openai/gpt-5-mini

# Порт, на котором запускается приложение.
PORT=8000

# Описание того, что продаёт компания. Нужно, чтобы помощник правильно
# определял "целевой / нецелевой" лид. 1-2 предложения.
# Пример: "Продаём CRM-систему и техническую поддержку для B2B-компаний."
COMPANY_DESCRIPTION=

# ---------------------------------------------------------------------------
# Битрикс24 CRM
# ---------------------------------------------------------------------------
# Адрес входящего вебхука. Взять в Битрикс24: CRM -> Настройки ->
# Разработчикам -> Другое -> Входящий вебхук. Скопировать сюда целиком.
# Пример: https://portal.bitrix24.ru/rest/1/abcdefghijklmnop/
B24_URL=

# ID ответственного менеджера (ему создаётся задача).
# Если пусто — берётся ID владельца вебхука из адреса выше.
# ID пользователя видно в его профиле в Битрикс24.
B24_MANAGER_ID=

# ID чата для уведомлений о новых заявках.
# Если пусто — уведомления не отправляются, лид и задача создаются.
# Список своих чатов с ID покажет кнопка "Проверить Битрикс24" в приложении.
B24_CHAT_ID=

# Источник лида (WEB, WEBFORM, CALL, OTHER и другие).
B24_SOURCE_ID=WEB

# Валюта суммы лида.
B24_CURRENCY_ID=RUB

# Через сколько дней у задачи истекает срок.
B24_TASK_DAYS=1

B24_URL=
